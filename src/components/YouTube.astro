---
interface Props {
  id: string; // The video ID from the YouTube URL (e.g., dQw4w9WgXcQ)
}

const { id } = Astro.props;
---
<div class="w-full aspect-video rounded-2xl overflow-hidden border border-accent/20 shadow-[0_0_30px_rgba(var(--accent-rgb),0.1)] my-8">
  <iframe
    width="100%"
    height="100%"
    src={`https://www.youtube.com/embed/${id}`}
    title="YouTube video player"
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
  ></iframe>
</div>