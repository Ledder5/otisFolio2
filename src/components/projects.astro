---
import ProjectCard from './project-card.astro';
import projectsData from '../data/projects.json';

// --- CONFIGURATION ---
const INITIAL_MOBILE = 3;   // Projects shown on mobile first load
const INITIAL_DESKTOP = 6;  // Projects shown on desktop first load
const LOAD_MORE_COUNT = 3;  // Projects to reveal per click

const totalProjects = projectsData.length;
const hasMoreMobile = totalProjects > INITIAL_MOBILE;

// --- EXTRACT UNIQUE TECHS ---
const allTechs = projectsData.flatMap((project: any) => project.tech || []);
const uniqueTechs = [...new Set(allTechs)].sort();
---

<section id="projects" class="section-container overflow-hidden">
  <div class="container mx-auto">
    <div class="mb-10 project-header">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
          <span class="text-accent">/</span> Featured Projects
        </h2>
      <p class="text-subtext font-body text-sm max-w-md">
        A selection of my freelance work, personal projects, and university courcework.
      </p>
    </div>

    {/* --- NEW FILTER BAR --- */}
    <div class="mb-12 flex flex-wrap gap-2 md:gap-3 project-header">
      <button 
        class="filter-btn active-filter px-4 py-1.5 rounded-full text-xs font-body border border-accent/10 bg-transparent text-subtext transition-all hover:border-accent/40 hover:text-maintext cursor-pointer" 
        data-tech="all"
      >
        All
      </button>
      {uniqueTechs.map(tech => (
        <button 
          class="filter-btn px-4 py-1.5 rounded-full text-xs font-body border border-accent/10 bg-transparent text-subtext transition-all hover:border-accent/40 hover:text-maintext cursor-pointer" 
          data-tech={tech}
        >
          {tech}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="projects-grid">
      {projectsData.map((project: any, index) => {
        
        // Smart visibility logic mapping to Tailwind classes
        let visibilityClass = '';
        if (index >= INITIAL_DESKTOP) {
          visibilityClass = 'hidden'; // Hidden everywhere initially
        } else if (index >= INITIAL_MOBILE) {
          visibilityClass = 'hidden md:block'; // Hidden on mobile, but visible on desktop
        }

        const techString = project.tech ? project.tech.join(',') : '';

        return (
          <div 
            class={`project-wrapper h-full ${visibilityClass}`}
            data-initial-class={`project-wrapper h-full ${visibilityClass}`}
            data-techs={techString}
          >
            <ProjectCard project={project} />
          </div>
        )
      })}
    </div>

    {/* Conditionally render View More button */}
    {hasMoreMobile && (
      <div 
        id="view-more-container" 
        class={`mt-16 flex justify-center project-header ${totalProjects <= INITIAL_DESKTOP ? 'md:hidden' : ''}`}
      >
        <button 
          id="view-more-btn" 
          data-load={LOAD_MORE_COUNT}
          class="group relative inline-flex items-center justify-center px-10 py-2 bg-white/5 border border-[color-mix(in_srgb,var(--color-accent),transparent_50%)] rounded-full text-maintext font-body transition-all duration-300 bg-accent/10 shadow-[0_0_20px_color-mix(in_srgb,var(--color-accent),transparent_70%)] md:border-[color-mix(in_srgb,var(--color-accent),transparent_50%)] md:bg-accent/10 md:shadow-none md:hover:border-accent/50 md:hover:bg-accent/10 md:hover:shadow-[0_0_20px_color-mix(in_srgb,var(--color-accent),transparent_70%)] hover:scale-105 cursor-pointer"
        >
          <div class="flex flex-col items-center justify-center text-center">
            <span class="tracking-wide text-sm md:text-base font-medium transition-transform duration-300 md:translate-y-2 md:group-hover:translate-y-0">
              View More
            </span>
            
            <span class="text-[10px] text-subtext font-light whitespace-nowrap transition-all duration-300 
                         /* Mobile: Always visible */
                         opacity-100 translate-y-0 
                         /* Desktop: Hidden until hover */
                         md:opacity-0 md:translate-y-1 md:group-hover:opacity-100 md:group-hover:translate-y-0">
              Discover My Work
            </span>
          </div>
          
          <div class="absolute inset-0 rounded-full blur-md bg-accent/20 -z-10 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500"></div>
        </button>
      </div>
    )}
  </div>
</section>

<style>
  /* Header & Button Initial State */
  .project-header {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Shared Revealed State */
  .project-header.reveal {
    opacity: 1 !important;
    transform: translateY(0) scale(1) !important;
  }

  /* --- NEW ACTIVE FILTER STYLE --- */
  .filter-btn.active-filter {
    background-color: color-mix(in srgb, var(--color-accent) 15%, transparent) !important;
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent) !important;
    color: var(--color-accent) !important;
  }
</style>

<script>
  const initProjectReveal = () => {
    // 1. --- VIEW MORE BUTTON LOGIC ---
    const btn = document.getElementById('view-more-btn');
    const container = document.getElementById('view-more-container');
    
    if (btn && container) {
      btn.addEventListener('click', () => {
        const loadCount = parseInt(btn.getAttribute('data-load') || '3');
        const allWrappers = document.querySelectorAll('.project-wrapper');
        let revealed = 0;
        
        for (const wrapper of allWrappers) {
          // We check the computed style to see if the browser is currently hiding it.
          // This makes the logic bulletproof whether the user is currently on mobile or desktop!
          if (window.getComputedStyle(wrapper).display === 'none') {
            wrapper.classList.remove('hidden', 'md:block');
            revealed++;
            
            if (revealed >= loadCount) break;
          }
        }

        // Check if there are any projects left to reveal
        const stillHidden = Array.from(allWrappers).some(w => window.getComputedStyle(w).display === 'none');
        if (!stillHidden) {
          container.style.display = 'none'; // Permanently hide the button
        }
      });
    }

    // 2. --- FILTERING LOGIC ---
    const filterBtns = document.querySelectorAll('.filter-btn');
    const allWrappers = document.querySelectorAll('.project-wrapper');
    const viewMoreContainer = document.getElementById('view-more-container');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Remove active class from all buttons, add to clicked button
        filterBtns.forEach(b => b.classList.remove('active-filter'));
        btn.classList.add('active-filter');

        const selectedTech = btn.getAttribute('data-tech') || '';

        allWrappers.forEach(wrapper => {
          const projectTechs = (wrapper.getAttribute('data-techs') || '').split(',');
          
          if (selectedTech === 'all') {
            // Restore exact original pagination classes
            wrapper.className = wrapper.getAttribute('data-initial-class') || '';
          } else {
            // If filtering, remove hidden classes if it matches, otherwise hide it
            if (projectTechs.includes(selectedTech)) {
              wrapper.className = 'project-wrapper h-full'; 
            } else {
              wrapper.className = 'project-wrapper h-full hidden';
            }
          }
        });

        // Handle View More button visibility
        if (viewMoreContainer) {
          if (selectedTech === 'all') {
            // If returning to "All", check if any projects are still naturally hidden
            const stillHidden = Array.from(allWrappers).some(w => window.getComputedStyle(w).display === 'none');
            viewMoreContainer.style.display = stillHidden ? 'flex' : 'none';
          } else {
            // Always hide "View More" when a specific filter is active
            viewMoreContainer.style.display = 'none';
          }
        }
      });
    });

    // 3. --- ANIMATION OBSERVER LOGIC ---
    const headers = document.querySelectorAll('.project-header');
    const cards = document.querySelectorAll('.project-card');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const target = entry.target as HTMLElement;
          
          if (target.classList.contains('project-header')) {
            target.classList.add('reveal');
            observer.unobserve(target);
          } 
          else if (target.classList.contains('project-card')) {
            const index = Array.from(cards).indexOf(target);
            
            // Stagger effect based on row position
            setTimeout(() => {
              target.classList.add('reveal');
            }, (index % 3) * 150);
            
            observer.unobserve(target);
          }
        }
      });
    }, { 
      threshold: 0.15, 
      rootMargin: '0px 0px -10px 0px' 
    });

    // Observe headers and all cards
    headers.forEach(header => observer.observe(header));
    cards.forEach(card => observer.observe(card));
  };

  // Run on initial load
  window.addEventListener('load', initProjectReveal);

  // Support for Astro View Transitions
  document.addEventListener('astro:after-swap', initProjectReveal);
</script>